{
  "name": "planejador-comodos",
  "private": true,
  "version": "1.0.0",
  "description": "Planejador de móveis em 3D a partir de scans do Apple RoomPlan, com medidas reais.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "exemplo": "node tools/gerar-exemplo.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.5.0",
    "@react-three/fiber": "9.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.178.0",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.178.1",
    "@vitejs/plugin-react": "4.6.0",
    "typescript": "5.8.3",
    "vite": "7.0.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
